PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campuspulse
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173

# ── AI Provider ─────────────────────────────────────────────────────────────
# Auto-detect order: GROQ_API_KEY → groq, GEMINI_API_KEY → gemini,
# OLLAMA_MODEL set → ollama, else none (rule-based fallback).
# Override by setting AI_PROVIDER = groq | gemini | ollama | none
AI_PROVIDER=

# Groq (recommended — free tier, fast hosted inference)
# Get a free key at: https://console.groq.com
# Verify current free model names at: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (fallback — free tier via AI Studio)
# Get a free key at: https://aistudio.google.com
# Verify current model names at: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (optional / legacy — fully offline, heavy on laptops)
# Only use if you want no data leaving your machine at all.
# 1. Install: https://ollama.com/download
# 2. Run: ollama pull llama3.2
# 3. Set OLLAMA_MODEL below
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
