PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campuspulse
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173

# Optional. Powers real AI generation for CV Builder and internship matching,
# using a free, local model via Ollama (https://ollama.com) — no API key,
# no cost, nothing leaves your machine.
#   1. Install Ollama from https://ollama.com/download
#   2. Run: ollama pull llama3.2   (or another model of your choice)
#   3. Set OLLAMA_MODEL below to match
# Leave OLLAMA_MODEL blank to use the built-in rule-based fallback instead —
# both features still work without this, just with simpler output.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
